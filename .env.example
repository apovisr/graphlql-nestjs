NODE_ENV=development
PORT=3000

# PostgreSQL (docker-compose.yml usa estas mismas variables)
DB_HOST=localhost
DB_PORT=5432
DB_USER=biblioteca
DB_PASSWORD=biblioteca
DB_NAME=biblioteca

# Imprime cada SQL en la consola: útil para ver el N+1 en vivo
DB_LOG_SQL=true

# Protecciones contra consultas abusivas (0 = desactivada)
MAX_QUERY_DEPTH=7
MAX_QUERY_COMPLEXITY=1000

# Multiplicador del volumen de datos del seed (1 = ~5.000 libros)
SEED_SCALE=1
